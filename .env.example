# Copy to .env — `rusted` loads it from the working directory at startup.

# Postgres (make db starts the compose instance this default points at)
DATABASE_URL=postgres://rusted:rusted@127.0.0.1:5457/rusted

# GitHub OAuth app — create one at https://github.com/settings/developers
# with the callback URL below, then fill these in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:7412/auth/github/callback

# API key for the CLI (create one at http://127.0.0.1:7412/console/keys)
RUSTED_API_KEY=

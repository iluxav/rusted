# Copy to .env — `rusted` loads it from the working directory at startup.

# Postgres (make db starts the compose instance this default points at)
DATABASE_URL=postgres://rusted:rusted@127.0.0.1:5457/rusted

# GitHub OAuth app — create one at https://github.com/settings/developers
# with the callback URL below, then fill these in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:7412/auth/github/callback

# API key for the CLI. Usually unnecessary — `rusted login` stores one for you.
# Set this in CI, where no browser exists to approve a device.
RUSTED_API_KEY=

# Who may change their own plan, by GitHub login, comma-separated. Empty means
# nobody: checkout takes no payment, so on a public deployment this is what
# stops any signed-in account from granting itself the top tier.
RUSTED_BILLING_ALLOWLIST=

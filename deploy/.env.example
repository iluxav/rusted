# Copy to .env on the server. Never commit the filled-in version.

DOMAIN=rusted.sh
PUBLIC_URL=https://rusted.sh

# Anything long and random: openssl rand -hex 32
POSTGRES_PASSWORD=

# GitHub OAuth app with callback https://rusted.sh/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Pin a release rather than tracking latest.
RUSTED_VERSION=v0.1.1
